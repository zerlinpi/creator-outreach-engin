NODE_ENV=development

# Multi-mailbox mode. Account ids: lowercase letters, numbers, underscores.
MAIL_ACCOUNTS=campx,hassky
MAIL_DEFAULT_ACCOUNT=campx

MAIL_CAMPX_USERNAME=
MAIL_CAMPX_APP_PASSWORD=
MAIL_CAMPX_FROM_NAME=CAMPX
# Optional provider overrides; defaults below are Alibaba Mail.
# MAIL_CAMPX_IMAP_HOST=imap.qiye.aliyun.com
# MAIL_CAMPX_IMAP_PORT=993
# MAIL_CAMPX_SMTP_HOST=smtp.qiye.aliyun.com
# MAIL_CAMPX_SMTP_PORT=465

MAIL_HASSKY_USERNAME=
MAIL_HASSKY_APP_PASSWORD=
MAIL_HASSKY_FROM_NAME=HASSKY Mobility
# MAIL_HASSKY_IMAP_HOST=imap.qiye.aliyun.com
# MAIL_HASSKY_IMAP_PORT=993
# MAIL_HASSKY_SMTP_HOST=smtp.qiye.aliyun.com
# MAIL_HASSKY_SMTP_PORT=465

# Legacy single-mailbox compatibility. Leave MAIL_ACCOUNTS unset to use these.
# MAIL_USERNAME=
# MAIL_APP_PASSWORD=
# MAIL_FROM_NAME=CAMPX

MAIL_IMAP_HOST=imap.qiye.aliyun.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.qiye.aliyun.com
MAIL_SMTP_PORT=465
MAIL_CONNECTION_TIMEOUT_MS=15000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=30000
MAIL_MAX_MESSAGE_BYTES=10485760
MAIL_SEARCH_SOURCE_BYTES=131072

CONNECTOR_AUTH_TOKEN=
CONNECTOR_ALLOWED_HOSTS=localhost,127.0.0.1
CONNECTOR_JSON_LIMIT=1mb

# Optional ChatGPT OAuth. Configure all three together in production.
OAUTH_ISSUER=
OAUTH_LOGIN_PASSWORD=
OAUTH_SIGNING_SECRET=

PORT=3000

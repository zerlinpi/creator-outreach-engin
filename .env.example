NODE_ENV=development

# Recommended: enable the browser Mailbox Manager at /admin.
# Login username is always: admin
MAIL_ADMIN_PASSWORD=
# 32+ character secret used only to encrypt mailbox passwords at rest.
MAIL_ACCOUNT_STORE_KEY=
MAIL_ACCOUNT_STORE_PATH=./data/mail-accounts.enc.json
MAIL_MAX_ACCOUNTS=50
# Optional stable signing key for message_ref values. Set this if CONNECTOR_AUTH_TOKEN may rotate.
MAIL_MESSAGE_REF_SIGNING_KEY=

# Optional legacy/environment-managed mailboxes. These remain read-only in the UI.
# MAIL_ACCOUNTS=campx,hassky
# MAIL_DEFAULT_ACCOUNT=campx
# MAIL_CAMPX_USERNAME=
# MAIL_CAMPX_APP_PASSWORD=
# MAIL_CAMPX_FROM_NAME=CAMPX
# MAIL_HASSKY_USERNAME=
# MAIL_HASSKY_APP_PASSWORD=
# MAIL_HASSKY_FROM_NAME=HASSKY Mobility

# Legacy single-mailbox compatibility.
# MAIL_USERNAME=
# MAIL_APP_PASSWORD=
MAIL_FROM_NAME=CAMPX

# Shared transport defaults used by UI-managed accounts unless changed in the UI.
MAIL_IMAP_HOST=imap.qiye.aliyun.com
MAIL_IMAP_PORT=993
MAIL_IMAP_ACCOUNT_CONCURRENCY=2
MAIL_SMTP_HOST=smtp.qiye.aliyun.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURITY=tls
MAIL_ALL_ACCOUNT_READ_CONCURRENCY=4
MAIL_MULTI_ACCOUNT_SEND_CONCURRENCY=3
MAIL_CONNECTION_TIMEOUT_MS=15000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=30000
MAIL_MAX_MESSAGE_BYTES=10485760
MAIL_SEARCH_SOURCE_BYTES=131072

CONNECTOR_AUTH_TOKEN=
CONNECTOR_ALLOWED_HOSTS=localhost,127.0.0.1
CONNECTOR_JSON_LIMIT=1mb

# Optional ChatGPT OAuth.
OAUTH_ISSUER=
OAUTH_LOGIN_PASSWORD=
OAUTH_SIGNING_SECRET=

PORT=3000

{
  "name": "creator-outreach-engin",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean --silent && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "doctor": "npm run build --silent && node --env-file-if-exists=.env dist/src/doctor.js",
    "test:limit": "vitest run tests/limit",
    "test:provider-pacing": "vitest run tests/integration/provider-pacing-live.integration.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "verify": "npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.1.0",
    "imapflow": "^1.0.195",
    "mailparser": "^3.7.4",
    "nodemailer": "^10.0.10",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}

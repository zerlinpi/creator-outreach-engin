{
  "name": "creator-outreach-engin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP connector for reading and sending CAMPX creator outreach mail.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/server.ts",
    "test": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:integration": "node --test --experimental-strip-types tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "imapflow": "^2.0.5",
    "nodemailer": "^10.0.10",
    "postal-mime": "^3.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
